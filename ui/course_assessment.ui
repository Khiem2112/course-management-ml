   <string notr="true">QMainWindow {
    background-color: #f6f6f6;
}
QFrame {
    background-color: #f6f6f6;
}
#centralwidget{
	background-color: #f6f6f6;
}
#menu {
    background-color: #f9f9f9;
    border-right: 1px solid #e0e0e0;
}
QLabel#brand {
    color: black;
}

#header_result,
#header_assessment,
#header_student {

border: none;
padding: 5px 10px;
}

#header_assessment {

background-color: #4C8BF5; /* A vibrant blue (matches existing create button) */
    
    /* Ensure it overrides the basic button style from the common rule */
    border: none;
    padding: 5px 10px;
    
    /* Optional visual flair */
    border-radius: 4px; 
    font-weight: bold;
}


#header_return {

background-color: black;
color: red;
border: none;
padding: 5px 10px;
font-weight:bold;
}

#menu_analysis,
#menu_course,
#menu_payment,
#menu_student,
#menu_setting {
    text-align: left;
    padding: 8px 20px;
    border: none;
	color: black;
}
#menu_analysis:hover,
#menu_course:hover,
#menu_logout:hover,
#menu_payment:hover,
#menu_student:hover,
#menu_setting:hover {
    background-color: #eaeaea;
}
#menu_logout {
    color: red;
    padding: 10px;
    text-align: left;
	border: none;
}
#menu_course {
    background-color: #eaeaea;
}
#course_assessment_search_lineEdit {
    background-color: #F8F8F8;
    border: 1px solid #CCCCCC;
    border-radius-right: 10px;
    padding: 6px 12px;
    color: #555;
}
#course_assessment_search_lineEdit:focus {
    border: 2px solid #A0A0A0;
}
#course_assessment_search_comboBox {
    background-color: #2E2E2E;
    color: white;
    padding: 6px 12px;
    font-weight: bold;
}
QComboBox QAbstractItemView {
    background-color: #2E2E2E;
    color: white;
    selection-background-color: #444444;
    selection-color: white;
}
#course_assessment_create {
    background-color: #4C8BF5;
    color: white;
    border: none;
    border-radius: 8px;
    padding: 6px 10px;
    font-weight: bold;
}
#course_assessment_create:hover {
    background-color: #3B73E0;
}
#course_assessment_filter {
    background-color: #F4F4F4;
    border: 1px solid #CCCCCC;
    border-radius: 8px;
    padding: 6px 10px;
	color: black;
}
#course_assessment_filter:hover {
    background-color: #EAEAEA;
}
#header{
	background-color: #f9f9f9;
	color: black;
}
#course_assessment_previous, #course_assessment_next {
    background-color: white;
    color: #2E3A59;
    border: 1px solid #D0D0D0;
    border-radius: 8px;
    padding: 6px 12px;
    font-weight: 500;
}
#course_assessment_previous:hover, #course_assessment_next:hover {
    background-color: #F5F5F5;
}
#course_assessment_page_1, #course_assessment_page_2, #course_assessment_page_3, #course_assessment_page_8, #course_assessment_page_9, #course_assessment_page_10 {
    background-color: transparent;
    border: none;
    color: #444;
    padding: 6px 10px;
}
#course_assessment_page_1 {
    background-color: #E0E0E0;
    border-radius: 6px;
    font-weight: bold;
}
#space {
    color: #777;
    font-weight: bold;
}


